{
  "name": "wenqu-qa",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c green,cyan \"npm run dev -w server\" \"npm run dev -w web\"",
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w web",
    "start": "npm run start -w server",
    "db:init": "npm run db:init -w server",
    "db:start": "node ../blog/scripts/start-db.mjs",
    "test": "npm run test -w server"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "concurrently": "^9.2.1",
    "playwright-core": "^1.64.1"
  }
}
